# Extension API endpoint used by the Vite build.
VITE_API_ORIGIN=http://localhost:9002/api
VITE_CLOUDFLARE_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace

# Configure either a PAC URL or a fixed proxy. PAC takes precedence.
SUPERTUNNEL_PAC_URL=
SUPERTUNNEL_PROXY_HOST=127.0.0.1
SUPERTUNNEL_PROXY_PORT=8080
SUPERTUNNEL_PROXY_SCHEME=http
SUPERTUNNEL_BYPASS_LIST=<local>,localhost,127.0.0.1

# Optional bearer token shared by the API and extension popup.
SUPERTUNNEL_API_TOKEN=
