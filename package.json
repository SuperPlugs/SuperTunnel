{
  "name": "supertunnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"]
  },
  "contributors": [
    "Benny 01r <benny01r@gmail.com>",
    "Irshad Siddi <mohammadirshadsiddi@gmail.com>"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src extension scripts vite.config.ts vite.config.firefox.ts next.config.ts eslint.config.mjs postcss.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:extension": "vite build --watch --config vite.config.ts",
    "build:extension": "vite build --config vite.config.ts",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "package:chrome": "pnpm build:extension && node scripts/package-chrome.mjs",
    "package:firefox": "pnpm build:firefox && node scripts/package-firefox.mjs",
    "package": "pnpm package:chrome && pnpm package:firefox",
    "gen:icons": "node scripts/gen-icons.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm package && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
